# ---- Core ----
PORT=5000
NODE_ENV=development

# ---- MongoDB (local, or Atlas M0 free: https://www.mongodb.com/cloud/atlas) ----
MONGODB_URI=mongodb://127.0.0.1:27017/nuzio

# ---- Google OAuth (no Firebase) ----
# console.cloud.google.com -> APIs & Services -> OAuth consent screen (External)
# -> Credentials -> Create credentials -> OAuth client ID -> Web application
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=

# ---- Session ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=nuzio-dev-secret-change-me

# ---- Gemini AI (Google AI Studio) ----
# aistudio.google.com -> Get API key (free tier, no billing needed)
AI_API_KEY=
# Evergreen aliases are recommended: Google retires concrete versions for new
# users over time (gemini-2.5-flash is already 404 for new accounts).
# Other verified options: gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
AI_MODEL=gemini-flash-latest
AI_FALLBACK_MODEL=gemini-flash-lite-latest

# ---- CORS ----
CLIENT_URL=http://localhost:5173
