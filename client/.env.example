# Backend API base URL.
# Leave EMPTY to use the Vite dev proxy (/api -> http://localhost:5000).
# For production set e.g. VITE_API_URL=https://your-api.onrender.com/api/v1
VITE_API_URL=

# Google OAuth Client ID (no Firebase needed).
# console.cloud.google.com -> APIs & Services -> Credentials -> Create credentials
#   -> OAuth client ID -> Web application
# Authorized JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
